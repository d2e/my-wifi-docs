  <diagram id="hld-detail---context-&amp;-flows" name="HLD detail - context &amp; flows">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;HLD — Whole-Home Gigabit Mesh &amp;amp; Automation Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(85, 85, 85);&quot;&gt;Single flat L3 subnet 192.168.0.0/24 · zero routers below the gateway · JioRouter AX6000 (192.168.0.50) is the primary automation hub · TP-Link Archer A6 (.12) is secondary AP&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1400" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="wan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontStyle=1;" value="&lt;b&gt;Fiber WAN — ISP GPON&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="300" x="760" y="96" as="geometry" />
        </mxCell>
        <mxCell id="nokia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Nokia G-2425G-A  ·  192.168.0.1&lt;/b&gt;&lt;br&gt;GPON ONT + master gateway (MTK7528)&lt;br&gt;Master DHCP server · advertises DNS .50 → .12 → 1.1.1.1&lt;br&gt;Wi-Fi: 5G ch44 VHT80 · 2.4G ch11 HT20&lt;br&gt;Mgmt: web + SSH/telnet (restricted vendor CLI, no root)" vertex="1">
          <mxGeometry height="118" width="420" x="700" y="176" as="geometry" />
        </mxCell>
        <mxCell id="ap1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" value="&lt;b&gt;Huawei HG8145V5 — AP #1  ·  .110&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#b85450;font-weight:bold;&quot;&gt;[DEPRECATED / DECOMMISSIONED]&lt;/span&gt;&lt;br&gt;Replaced by JioRouter AX6000 (.50)&lt;br&gt;Permanently removed from active RF mesh &amp;amp; poller loops" vertex="1">
          <mxGeometry height="118" width="360" x="80" y="390" as="geometry" />
        </mxCell>
        <mxCell id="ap2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Huawei HG8145V5 — AP #2  ·  .98&lt;/b&gt;&lt;br&gt;Pure L2 AP + TP-Link’s uplink  ⚠ single point of failure&lt;br&gt;5G ch52 (DFS) · 2.4G ch11 · both pinned&lt;br&gt;Mgmt: telnet vendor CLI (USB migrated to JioRouter)" vertex="1">
          <mxGeometry height="118" width="420" x="560" y="390" as="geometry" />
        </mxCell>
        <mxCell id="tplink" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;TP-Link Archer A6 v3 — Secondary AP · .12&lt;/b&gt;&lt;br&gt;Uplink: Cat6 into AP #2 LAN port (⚠ chained SPOF)&lt;br&gt;5G ch36 VHT80 · 2.4G ch6 HT20 · OpenWrt 23.05.5&lt;br&gt;Secondary DNS (adblock-fast fallback)&lt;br&gt;&lt;b&gt;Web redirect:&lt;/b&gt; /www/index.html → &lt;b&gt;http://192.168.0.50/mesh.html&lt;/b&gt;" vertex="1">
          <mxGeometry height="118" width="420" x="1080" y="390" as="geometry" />
        </mxCell>
        <mxCell id="hub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;arcSize=4;fillColor=#f6fff4;strokeColor=#82b366;" value="&lt;b&gt;JioRouter AX6000 · 192.168.0.50 (OpenWrt SNAPSHOT MT7986 ARM64) — PRIMARY AUTOMATION HUB &amp;amp; USB MEDIA HOST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#2d572c;&quot;&gt;Wi-Fi 6 (5G ch36 HE160 · 2.4G ch1 HE20 4x4) · Direct Cat6 to Nokia · Hosts mesh.html, ac.html, ucode pollers, REST APIs &amp;amp; USB 3.0 Media Storage&lt;/span&gt;" vertex="1">
          <mxGeometry height="420" width="1380" x="140" y="570" as="geometry" />
        </mxCell>
        <mxCell id="meshpoll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;mesh-poller.uc&lt;/b&gt;&lt;br&gt;procd, ~2 s cycle&lt;br&gt;RF/latency/clients/self-heal&lt;br&gt;Capabilities A–G" vertex="1">
          <mxGeometry height="92" width="220" x="160" y="630" as="geometry" />
        </mxCell>
        <mxCell id="roam" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;roam-daemon.uc&lt;/b&gt;&lt;br&gt;sticky-client watchdog&lt;br&gt;deauth via AP #2&lt;br&gt;invoked per poll cycle" vertex="1">
          <mxGeometry height="92" width="190" x="400" y="630" as="geometry" />
        </mxCell>
        <mxCell id="entpoll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;entertainment-poller.uc&lt;/b&gt;&lt;br&gt;3 s cycle · TV/Fire TV telemetry&lt;br&gt;app-aware DSP auto-switch&lt;br&gt;Shizuku/agent keep-alive" vertex="1">
          <mxGeometry height="92" width="220" x="610" y="630" as="geometry" />
        </mxCell>
        <mxCell id="acpoll" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;ac-poller.uc&lt;/b&gt;&lt;br&gt;10 s cycle · MirAIe telemetry&lt;br&gt;energy ledger + 4 AI models" vertex="1">
          <mxGeometry height="92" width="220" x="850" y="630" as="geometry" />
        </mxCell>
        <mxCell id="usb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;Local USB 3.0 Media Storage (28 GB ext4)&lt;/b&gt;&lt;br&gt;Directly mounted at /mnt/sda1 (/mnt/usb) on JioRouter .50&lt;br&gt;transmission-daemon :9091 · minidlnad :8200 UPnP&lt;br&gt;Supervised locally via procd &amp;amp; mesh-poller" vertex="1">
          <mxGeometry height="92" width="410" x="1090" y="630" as="geometry" />
        </mxCell>
        <mxCell id="dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;dnsmasq + adblock-fast&lt;/b&gt;&lt;br&gt;28 k domains blocked&lt;br&gt;Primary whole-home DNS + leases" vertex="1">
          <mxGeometry height="80" width="220" x="160" y="736" as="geometry" />
        </mxCell>
