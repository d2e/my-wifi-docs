      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="&lt;b style=&quot;font-size:22px&quot;&gt;Whole-Home Network &amp;amp; Automation &amp;#8212; High-Level Design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;One flat network. JioRouter AX6000 (192.168.0.50) is the central automation hub &amp;amp; hosts the dashboard.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1340" height="60" as="geometry" />
