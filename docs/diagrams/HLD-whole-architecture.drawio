          <mxGeometry height="80" width="560" x="940" y="736" as="geometry" />
        </mxCell>
        <mxCell id="state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#9e9e9e;dashed=1;" value="&lt;b&gt;/tmp state (tmpfs, atomic writes)  ·  /etc caches&lt;/b&gt;&lt;br&gt;mesh-status.json · entertainment-status.json · ac-status.json · mesh-history.tsv · dsp-auto.log · mesh-selfheal.log  |  /etc/mesh-vendor-cache" vertex="1">
          <mxGeometry height="62" width="1340" x="160" y="830" as="geometry" />
