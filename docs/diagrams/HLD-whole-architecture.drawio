        <mxCell id="net" value="&lt;b&gt;① 🌐 Fiber Internet&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;arcSize=8;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
