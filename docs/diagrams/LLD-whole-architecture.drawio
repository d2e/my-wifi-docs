<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="my_wifi docs generator" version="24.0.0" type="device">
  <diagram id="lld-1-physical-topology,-rf-plan-&amp;-self-" name="LLD-1 Physical topology, RF plan &amp; self-healing">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value='&lt;b style="font-size:19px"&gt;LLD-1 &amp;#8212; L1/L2 topology, radio plan and channel self-healing&lt;/b&gt;&lt;br&gt;&lt;span style="color:#555"&gt;Not a flat star: AP #2 carries TP-Link&amp;#8217;s uplink. No L3 hops anywhere &amp;#8212; traceroute/TTL see nothing; the only path differences are Ethernet switch hops.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1400" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="wan" value="&lt;b&gt;Fiber WAN (GPON)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="86" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="nokia" value="&lt;b&gt;Nokia G-2425G-A  ·  192.168.0.1  ·  MTK7528&lt;/b&gt;&lt;br&gt;Role: WAN ONT, master DHCP, master DNS advertiser&lt;br&gt;5 GHz : ch 44, VHT80          2.4 GHz : ch 11, HT20&lt;br&gt;SSIDs: U101 (5G) / U101-slow (2.4G)&lt;br&gt;DHCP opt 6 → 192.168.0.12 (primary) , 1.1.1.1 (secondary)&lt;br&gt;Config path: encrypted web API (SJCL AES-CBC + RSA-1024)&lt;br&gt;  nokia_wifi_control.js --5g | --24g | --set-dns | --youtube&lt;br&gt;CLI: ssh admin@.1 → enable → show → wifi client list / lan ip hosts&lt;br&gt;⚠ Telnet/SSH closed by default (Security → Access Control, LAN only)&lt;br&gt;⚠ Not rooted: Password2 shell escape patched, config.cfg undecryptable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="480" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="ap1" value='&lt;b&gt;JioRouter AX6000 — 192.168.0.50 (Replaced AP #1)&lt;/b&gt;&lt;br&gt;Uplink: direct Cat6 to Nokia LAN port&lt;br&gt;Wi-Fi 6 (802.11ax) 4x4 MU-MIMO 160MHz&lt;br&gt;5 GHz : ch 36 HE160 (center ch 50)  2.4 GHz : ch 1 HE20&lt;br&gt;Hosts: Primary Automation Hub (mesh-poller, ac-poller, etc.)&lt;br&gt;       Primary DNS Ad-Blocker (adblock-fast + dnsmasq 28k+)&lt;br&gt;       Direct USB 3.0 Media Host (/mnt/sda1 Transmission &amp;amp; MiniDLNA)&lt;br&gt;Note: Huawei AP #1 (.110) decommissioned and replaced.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="420" width="520" height="212" as="geometry"/>
        </mxCell>
        <mxCell id="ap2" value="&lt;b&gt;Huawei HG8145V5 — AP #2  ·  192.168.0.98&lt;/b&gt;&lt;br&gt;Uplink: direct Cat6 to Nokia  |  downlink: Cat6 to TP-Link&lt;br&gt;5 GHz : ch 52 (DFS), 80 MHz   2.4 GHz : ch 11, HT20&lt;br&gt;Pin:  set wlan basic laninst 1 wlaninst 5 Channel 52&lt;br&gt;      set wlan basic laninst 1 wlaninst 1 Channel 11&lt;br&gt;telnet root/&lt;password&gt; → su → SU_WAP&amp;gt; → shell = REAL busybox&lt;br&gt;  → hostapd_cli -p /var/run/hostapd-wifi1 -i vap4 ...&lt;br&gt;  → iwpriv vap4 kick_user &amp;lt;mac&amp;gt; | channel &amp;lt;N&amp;gt;&lt;br&gt;⚠ Needs a real wall-clock sleep between CLI lines, or two&lt;br&gt;   commands merge into one (ERROR::Command is not existed)&lt;br&gt;⚠ ONE telnet session total; a half-closed one locks the CLI" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="420" width="520" height="212" as="geometry"/>
        </mxCell>
        <mxCell id="usb" value="&lt;b&gt;JioRouter USB Storage — 28 GB ext4&lt;/b&gt;&lt;br&gt;Real mount: /mnt/sda1 (symlinks /mnt/usb &amp;amp; /mnt/usb/data)&lt;br&gt;Mounted directly on JioRouter AX6000 (.50)&lt;br&gt;transmission-daemon  :9091   (procd supervised)&lt;br&gt;minidlnad            :8200   (procd supervised UPnP)&lt;br&gt;downloads/ + incomplete/ live directly on ext4 flash drive&lt;br&gt;File deletion queue: /tmp/mesh-pending-usb-deletes.txt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="420" width="400" height="212" as="geometry"/>
        </mxCell>
        <mxCell id="tplink" value="&lt;b&gt;TP-Link Archer A6 v3  ·  192.168.0.12  ·  OpenWrt 23.05.5&lt;/b&gt;&lt;br&gt;Uplink: Cat6 into an AP #2 LAN port  —  NOT to the gateway&lt;br&gt;5 GHz : ch 36, VHT80          2.4 GHz : ch 6, HT20&lt;br&gt;TX power: 23 dBm (5G) / 18 dBm (2.4G)&lt;br&gt;hostapd: ieee80211w=1 · max_inactivity=1200 · disassoc_low_ack=0&lt;br&gt;         cell_density=2 → basic_rates 120 240 (12 Mbps floor)&lt;br&gt;⚠ bss_transition (802.11v) is REJECTED by this hostapd build —&lt;br&gt;  adding it took both radios down mid-session. Do not re-add.&lt;br&gt;802.11k neighbour table pre-seeded via ubus with the other 3 APs&lt;br&gt;Hosts: dashboards, all pollers, dnsmasq + adblock-fast" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="700" width="640" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="hops" value="&lt;b&gt;Measured path cost (from JioRouter .50, central hub)&lt;/b&gt;&lt;br&gt;target            path                       switch hops   RTT&lt;br&gt;Nokia Gateway     direct cable (Nokia switch)    1        0.8-1.0 ms&lt;br&gt;Huawei AP #2      via Nokia switch               2        1.0-1.2 ms&lt;br&gt;TP-Link Archer A6 via AP #2 switch               3        1.1-1.3 ms&lt;br&gt;&lt;br&gt;All active nodes sub-1.5 ms wire speed. Huawei AP #1 is deprecated." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#9e9e9e;dashed=1;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="700" width="520" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="spof" value="&lt;b&gt;⚠ Structural single point of failure&lt;/b&gt;&lt;br&gt;AP #2 losing power or its LAN port takes TP-Link off the network:&lt;br&gt;dashboard, DNS/ad-blocking, usteer and every poller lose their path&lt;br&gt;to the gateway and the internet — even though TP-Link keeps running." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="900" width="520" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="rf" value="&lt;b&gt;5 GHz plan (non-overlapping)&lt;/b&gt;&lt;br&gt;  Jio AX6000 ch 36 (HE160)&lt;br&gt;  TP-Link    ch 36 (VHT80)&lt;br&gt;  Nokia      ch 44 (VHT80)&lt;br&gt;  AP #2      ch 52 (DFS, 80M)&lt;br&gt;  (AP #1 decommissioned)&lt;br&gt;&lt;br&gt;2.4 GHz plan (1 / 6 / 11)&lt;br&gt;  Jio AX6000 ch 1  (HE20)&lt;br&gt;  TP-Link    ch 6  (HT20)&lt;br&gt;  AP #2      ch 11 (HT20)&lt;br&gt;  Nokia      ch 11 (HT20)&lt;br&gt;&lt;br&gt;Ch 11 is reused by the two&lt;br&gt;physically furthest radios;&lt;br&gt;-81..-89 dBm isolation through&lt;br&gt;concrete, well under carrier&lt;br&gt;sense. All 2.4 radios 20MHz to&lt;br&gt;kill 40 MHz splatter.&lt;br&gt;&lt;br&gt;Security (all nodes):&lt;br&gt;  WPA/WPA2-PSK mixed,&lt;br&gt;  TKIP+AES (psk-mixed) —&lt;br&gt;  802.11k/r fast roaming&lt;br&gt;  synchronized across nodes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1740" y="150" width="260" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="heal" value='&lt;b&gt;Channel self-healing  (mesh-poller.uc, every ~20 s cycle)&lt;/b&gt;&lt;br&gt;An AP reboot silently returns the Huawei radios to carrier auto-select.&lt;br&gt;&lt;br&gt;1. read  display wifi radio  on AP #1 and AP #2&lt;br&gt;2. if the channel renders with an "(auto)" suffix on either band:&lt;br&gt;     re-apply both Channel pins for that AP&lt;br&gt;     lock bandwidth 20M (2.4G) · pmf 1 · txbf 1 · scs 0&lt;br&gt;     set tr069 info Enable 0 InformEnable 0 AcsUrl http://127.0.0.1&lt;br&gt;3. append the correction to /tmp/mesh-selfheal.log&lt;br&gt;&lt;br&gt;Expected values live in mesh-poller.uc as EXPECTED_* constants;&lt;br&gt;mesh-optimizer --apply rewrites them when it discovers a new plan.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="980" width="640" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="clients" value="&lt;b&gt;Client behaviour&lt;/b&gt;&lt;br&gt;One shared SSID across all 4 radios (802.11k roaming).&lt;br&gt;⚠ SSID tells you nothing about which AP a client is on —&lt;br&gt;  only BSSID + channel do.&lt;br&gt;&lt;br&gt;Roaming help:&lt;br&gt;  802.11k RRM  : on, all nodes&lt;br&gt;  802.11w PMF  : on, all nodes&lt;br&gt;  802.11v BTM  : NOT available on TP-Link&lt;br&gt;  usteer       : running fully PASSIVE (all thresholds 0)&lt;br&gt;  roam-daemon.uc: the real steering mechanism — deauth&lt;br&gt;    5 GHz below -76 dBm / 2.4 GHz below -80 dBm,&lt;br&gt;    3 consecutive cycles, 300 s cooldown, reason code 3,&lt;br&gt;    TP-Link clients and stationary devices exempt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1300" y="700" width="400" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wan" target="nokia">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="Cat6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f5597;fontColor=#2f5597;" edge="1" parent="1" source="nokia" target="ap1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Cat6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f5597;fontColor=#2f5597;" edge="1" parent="1" source="nokia" target="ap2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="Cat6  (the only path)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f5597;fontColor=#2f5597;" edge="1" parent="1" source="ap2" target="tplink">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="USB 3.0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2f5597;fontColor=#2f5597;" edge="1" parent="1" source="ap1" target="usb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="re-pin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="heal" target="ap1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="re-pin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="heal" target="ap2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lld-2-mesh-poller.uc-cycle-&amp;-data-pipeli" name="LLD-2 mesh-poller.uc cycle &amp; data pipeline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value='&lt;b style="font-size:19px"&gt;LLD-2 &amp;#8212; mesh-poller.uc: one poll cycle (~20 s), end to end&lt;/b&gt;&lt;br&gt;&lt;span style="color:#555"&gt;Every device read in the whole mesh happens here. The CGI layer never talks to a device &amp;#8212; it only serves what this loop last wrote.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;procd service&lt;/b&gt;&lt;br&gt;/etc/init.d/mesh-poller  (S99, enabled at boot)&lt;br&gt;exec: /usr/bin/ucode /usr/bin/mesh-poller.uc&lt;br&gt;⚠ mesh-poller.sh is retired — reference only, do not deploy" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;once, at poller start&lt;/b&gt;&lt;br&gt;healUsbDataSymlink()&lt;br&gt;  ln -sfn /mnt/usb/usb-_N /mnt/usb/data on AP #2&lt;br&gt;  (per-cycle would blow the AP #2 session budget)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="380" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Step 1 — reachability&lt;/b&gt;&lt;br&gt;ping -c 4 → Nokia .1, TP-Link .12, Huawei AP #2 .98&lt;br&gt;derive latency / jitter / packet loss per node (AP #1 deprecated)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;Step 2 — ARP refresh (every 3rd cycle)&lt;/b&gt;&lt;br&gt;backgrounded ping sweep of 192.168.0.1-254&lt;br&gt;keeps the neighbour table warm for client discovery" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="194" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Step 3 — local radios&lt;/b&gt;&lt;br&gt;iwinfo phy0-ap0 / phy1-ap0: per-client RSSI, channel&lt;br&gt;cumulative byte counters → throughput deltas (Mbps)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="288" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Step 4 — Local Storage &amp;amp; Media Stack (JioRouter AX6000)&lt;/b&gt;&lt;br&gt;Watchdog transmission-daemon &amp;amp; minidlnad under procd&lt;br&gt;Process pending USB deletions locally &amp;amp; audit /mnt/sda1/downloads&lt;br&gt;(Huawei AP #1 telnet loop removed upon deprecation)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="382" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Step 5 — Huawei AP #2 (telnet, ~18 s budget)&lt;/b&gt;&lt;br&gt;vendor CLI stats, then  shell  → real busybox:&lt;br&gt;  hostapd_cli all_sta        (station table)&lt;br&gt;  iwpriv vap4 ...            (Cap. C kicks, Cap. D survey)&lt;br&gt;  cd /mnt/usb/data/transmission &amp;amp;&amp;amp; ./start.sh   (Cap. F)&lt;br&gt;  ls -la .../downloads       (Cap. G inventory)&lt;br&gt;  rm -rf &amp;lt;queued basenames&amp;gt;  (Cap. G deletions)&lt;br&gt;then  exit  →  quit  + socket cleanup" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="476" width="600" height="151" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;Step 6 — Nokia gateway (SSH)&lt;/b&gt;&lt;br&gt;enable → show → wifi client list   (per-band clients)&lt;br&gt;                 → lan ip hosts     (live DHCP leases)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="645" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;Step 7 — identity + history&lt;/b&gt;&lt;br&gt;unknown MAC → api.macvendors.com → /etc/mesh-vendor-cache&lt;br&gt;append sample to /tmp/mesh-history.tsv (last 40)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="739" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value='&lt;b&gt;Step 8 — enforcement&lt;/b&gt;&lt;br&gt;channel self-heal: "(auto)" detected → re-pin both bands&lt;br&gt;roam-daemon.uc evaluate → deauth degraded clients&lt;br&gt;transmission watchdog verdict from start.sh’s own output' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="833" width="600" height="91" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value='&lt;b&gt;Step 9 — publish&lt;/b&gt;&lt;br&gt;serialise with sprintf("%.J") and write atomically to&lt;br&gt;/tmp/mesh-status.json  (tmpfs)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="942" width="600" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;/tmp/mesh-status.json&lt;/b&gt;&lt;br&gt;nodes[] latency/jitter/loss · clients[] (mac, ip, host, vendor, rssi, band, ap)&lt;br&gt;channels · throughput · nokia_wifi.clients_24g/5g · ap2_rf_watchdog&lt;br&gt;transmission_watchdog{status,last_restart,restart_count} · usb_files[]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#9e9e9e;dashed=1;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="1036" width="600" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;/www/cgi-bin/mesh-api  (ucode CGI)&lt;/b&gt;&lt;br&gt;action=status          → cat the cached JSON (instant)&lt;br&gt;action=optimize        → mesh-optimizer.uc --apply&lt;br&gt;action=sync_password   → push PSK to all APs&lt;br&gt;action=youtube_toggle  → Nokia parental ctl + dnsmasq&lt;br&gt;action=torrent_action  → Transmission RPC (+ delete queue)&lt;br&gt;action=roam_status / roam_kick" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;/www/mesh.html&lt;/b&gt;&lt;br&gt;Live Dashboard · Topology · Performance tabs&lt;br&gt;client chips grouped by AP, severity-coloured pills&lt;br&gt;canvas charts fed from mesh-history.tsv&lt;br&gt;Torrent Hub + USB file manager (Cap. G)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="270" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Queue files (CGI → poller hand-off)&lt;/b&gt;&lt;br&gt;/tmp/mesh-pending-usb-deletes.txt&lt;br&gt;CGI only validates + appends a basename;&lt;br&gt;the poller does the rm inside ITS session.&lt;br&gt;Reason: AP #2 allows one telnet session — a CGI&lt;br&gt;opening its own would collide with the poller." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#9e9e9e;dashed=1;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="420" width="420" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="others" value="&lt;b&gt;Sibling tools (same data, on demand)&lt;/b&gt;&lt;br&gt;mesh-optimizer.uc --apply   full RF survey + re-plan&lt;br&gt;  → also rewrites EXPECTED_* in mesh-poller.uc,&lt;br&gt;    ucode -c gated, backup restored on failure&lt;br&gt;mesh-observer.uc            congestion evaluator&lt;br&gt;  (watches TP-Link airtime + AP1/AP2 + Nokia n_cov)&lt;br&gt;huawei-expect               FIFO expect state machine&lt;br&gt;  ~0.75 s per telnet transaction, flock-serialised" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="550" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="gotchas" value="&lt;b&gt;Hard-won parsing / session rules&lt;/b&gt;&lt;br&gt;• Every echoed line is PREFIXED with the prompt&lt;br&gt;  (SU_WAP&amp;gt;get wlan ...) — never anchor a regex at ^.&lt;br&gt;• A BEL (0x07) trails every echoed command —&lt;br&gt;  strip with tr -d '\r\007' or $-anchors fail.&lt;br&gt;• Dopra VTYs emit \r\r, not \n — normalise with tr.&lt;br&gt;• This busybox nc takes NO flags (not even -w).&lt;br&gt;• This busybox sleep takes whole seconds only.&lt;br&gt;• Send a bare &quot;1&quot; after the password: it answers the&lt;br&gt;  &quot;session to be removed&quot; prompt, harmless otherwise.&lt;br&gt;• Markers you echo yourself are useless — the session&lt;br&gt;  echoes BOTH branches back. Parse real command output.&lt;br&gt;• A CGI backgrounding work must use&lt;br&gt;  &amp;lt;/dev/null &amp;gt;/dev/null 2&amp;gt;&amp;amp;1 &amp;amp; or the HTTP response hangs.&lt;br&gt;• ucode: a reference to a deleted let is null, not an&lt;br&gt;  error — it renders &quot;null&quot; into your command string.&lt;br&gt;  grep for the name after removing a variable.&lt;br&gt;• ucode regex: some [\s\S]*? patterns return null —&lt;br&gt;  prefer index()/substr() for source assertions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="720" width="420" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="caps" value='&lt;b&gt;Capabilities A–G&lt;/b&gt;&lt;br&gt;A  node reachability + latency/jitter/loss&lt;br&gt;B  client inventory across all 4 radios&lt;br&gt;   (+ DHCP hostname and MAC-vendor resolution)&lt;br&gt;C  sticky-client kicker via AP #2 busybox&lt;br&gt;D  ap2_rf_watchdog — live RF site survey&lt;br&gt;E  channel + TR-069 self-heal write-back&lt;br&gt;F  transmission-daemon watchdog&lt;br&gt;G  USB file inventory + queued deletion&lt;br&gt;&lt;br&gt;⚠ C and D never once fired before 2026-09-09:&lt;br&gt;the command before "shell" had no sleep, so the two&lt;br&gt;lines merged and everything after was dropped —&lt;br&gt;silently, because stderr goes to /dev/null.&lt;br&gt;&lt;br&gt;⚠ Capability F reported "down" forever while reading&lt;br&gt;an inline echo marker, and later restarted a healthy&lt;br&gt;daemon every cycle when a symlink heal pushed the&lt;br&gt;session past its time budget. Check mesh-selfheal.log&lt;br&gt;after ANY edit to this session.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="380" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svc" target="boot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="enter uloop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="boot" target="s1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="out" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e14" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e15" value="delete request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="ui" target="queue">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="drained next cycle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="queue" target="s5">
