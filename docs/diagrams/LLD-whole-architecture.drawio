  </diagram>
  <diagram id="lld-3-entertainment-&amp;-a/v-control-plane" name="LLD-3 Entertainment &amp; A/V control plane">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value='&lt;b style="font-size:19px"&gt;LLD-3 &amp;#8212; Entertainment stack: telemetry in, control out&lt;/b&gt;&lt;br&gt;&lt;span style="color:#555"&gt;Mi TV is the CEC bus master; the Sony is reachable only through it. Everything the router does to a TV goes over adb from the router, never from a workstation.&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="entpoll" value='&lt;b&gt;entertainment-poller.uc  —  3 s cycle (procd S99)&lt;/b&gt;&lt;br&gt;1  ping both TVs → TV_ONLINE / FTV_ONLINE gates&lt;br&gt;2  Mi TV now-playing, fast path:&lt;br&gt;     curl -m 1 http://192.168.0.10:8080/nowplaying&lt;br&gt;   fallback: parseMediaSession(dumpsys media_session)&lt;br&gt;3  Mi TV telemetry over adb — TWO batched shell calls:&lt;br&gt;     (a) system / RAM / DF / TEMP / PWR / WIN&lt;br&gt;     (b) AUDIO / HDMI / MEDIA&lt;br&gt;4  Fire TV: foreground activity + media session&lt;br&gt;5  edge-triggered DSP switch when either foreground&lt;br&gt;   package changes (incl. "None" → reset to Standard)&lt;br&gt;6  keep-alive when the TV is awake (ts % 30 &amp;lt; 4):&lt;br&gt;     revive shizuku_server, relaunch shield_remap.sh&lt;br&gt;7  write /tmp/entertainment-status.json  (+ dsp-auto.log)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="600" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="pollerlib" value='&lt;b&gt;poller-lib.uc  —  pure logic, unit-tested&lt;/b&gt;&lt;br&gt;parseMediaSession()        resolveTvAppName()&lt;br&gt;resolveFtvAppName()        resolveSoundProfileLabel()&lt;br&gt;resolveOutputType()        parseActiveAudioFormat()&lt;br&gt;describeAudioPath(fmt, sinkCode)   resolveSourceFormat(mime)&lt;br&gt;&lt;br&gt;⚠ parseActiveAudioFormat: closed/stale threads are printed&lt;br&gt;  with a LEADING DASH; live ones start at column 0. Ignore&lt;br&gt;  the dash and you report Dolby while the TV plays silence.&lt;br&gt;⚠ describeAudioPath needs the SINK: an identical compressed&lt;br&gt;  format means "Sony decodes" on ARC but "the TV’s own HAL&lt;br&gt;  decodes" on the speaker sink.&lt;br&gt;⚠ Never render a channel count for a passthrough stream —&lt;br&gt;  0x3 is the IEC61937 carrier, not the 5.1 inside it.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="600" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="dsp" value='&lt;b&gt;App-aware DSP auto-switching (edge-triggered)&lt;/b&gt;&lt;br&gt;source      foreground package              profile    sound_style&lt;br&gt;Fire TV     netflix|smarttube|apple|zee5|mx  Cinema 5.1      1&lt;br&gt;Fire TV     hotstar|sonyliv                  Voice Boost     3&lt;br&gt;Fire TV     launcher  (or "None" = standby)  Standard        0&lt;br&gt;Mi TV       plex|vlc|kodi|youtube            Cinema 5.1      1&lt;br&gt;Mi TV       hotstar|sonyliv                  Voice Boost     3&lt;br&gt;Mi TV       flauncher|projengmenu|launcher   Standard        0&lt;br&gt;&lt;br&gt;⚠ Night and Voice BOTH write sound_style=3; only&lt;br&gt;  sound_auto_volume_control (DRC) distinguishes them, so every&lt;br&gt;  profile now resets DRC explicitly on write.&lt;br&gt;⚠ Idle reset fires only when the TV is reachable — so an adb&lt;br&gt;  outage reads as "idle" and silently resets the profile.&lt;br&gt;Log: /tmp/dsp-auto.log (rolling 100 lines)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="600" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="warnadb" value='&lt;b&gt;⚠ adb rules that bite&lt;/b&gt;&lt;br&gt;• NEVER adb connect to the Mi TV from a workstation: the TV&lt;br&gt;  raises a new RSA prompt and the ROUTER’s session goes&lt;br&gt;  unauthorized. Recovery: kill-server on the router, then on&lt;br&gt;  the workstation, then a human must accept the on-screen&lt;br&gt;  dialog. Re-apply an audio profile afterwards.&lt;br&gt;• adb shell has an argv length limit: too many chained fields&lt;br&gt;  fail with "service name too long" — and the caller just sees&lt;br&gt;  empty output, so every parsed field falls back to a default.&lt;br&gt;  Keep combined queries batched; test new fields by hand first.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="600" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="tests" value='&lt;b&gt;Coverage for this plane&lt;/b&gt;&lt;br&gt;test-poller-lib.uc    pure logic, 30+ assertions, no device&lt;br&gt;regression-test.uc    live smoke; TV checks gated on a ping&lt;br&gt;  §3b scene handlers really write mjc   (source-level)&lt;br&gt;  §3c keep-alive string contains no "&amp;amp;;" (source-level)&lt;br&gt;  §3d surround policy never MANUAL&lt;br&gt;  §3e audio-profile coherence + optical enum&lt;br&gt;  §3f audio_format HUD branch (asserted, not fired)&lt;br&gt;  §3h non-numeric PQ rejected + live saturation &amp;gt; 0&lt;br&gt;  §3i picture mode pinned before PQ writes&lt;br&gt;gradle test           tv-telemetry-agent JUnit (JVM only —&lt;br&gt;  does NOT prove ART regex compatibility)' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1250" width="600" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="mitvapi" value='&lt;b&gt;/www/cgi-bin/mitv-api  (mitv-api.uc)&lt;/b&gt;&lt;br&gt;Transport control   wake · sleep · volume · hdmi_input · reboot&lt;br&gt;                    launch · force_stop · open_url · text&lt;br&gt;&lt;br&gt;Picture (PQ)        brightness contrast saturation sharpness&lt;br&gt;                    backlight hue color_temp local_dimming&lt;br&gt;                    game_mode noise_reduction film_mode&lt;br&gt;                    uhd_upscaling allm · display_state (dump)&lt;br&gt;                    display_preset · scene&lt;br&gt;  ⚠ PQ registers are stored PER PICTURE MODE. Every write&lt;br&gt;    lands in whatever mode is on screen, and picture_mode +&lt;br&gt;    picture_mode_dolby track each other. ALWAYS call&lt;br&gt;    ensurePictureMode(ip, target) first and bail if it&lt;br&gt;    returns false; never write picture_mode inline with&lt;br&gt;    the values. This bug repainted DV Bright black &amp;amp; white.&lt;br&gt;  ⚠ int("abc") is NaN and sprintf("%d", NaN) renders "0" —&lt;br&gt;    a malformed param used to silently write 0. Non-numeric&lt;br&gt;    input is now rejected outright.&lt;br&gt;&lt;br&gt;Audio               sound_profile · drc · sound_effects&lt;br&gt;                    sound_delay · audio_output · resync_arc&lt;br&gt;                    surround_mode · audio_profile · audio_format&lt;br&gt;  audio_profile=sony : ARC sink, surround AUTO, DTS suite off,&lt;br&gt;                       Theater, EQ flat, spdif delay 70 ms&lt;br&gt;  audio_profile=tv   : speaker sink, Virtual:X suite on,&lt;br&gt;                       small-driver EQ, delay 0&lt;br&gt;  status reports "custom" when sink and DSP disagree&lt;br&gt;&lt;br&gt;Policy              youtube_app_status / youtube_app_toggle&lt;br&gt;&lt;br&gt;⚠ escSQ() applied TWICE on any attacker-reachable param:&lt;br&gt;  adb shell is a double-hop (local sh → device sh).' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="640" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="firetvapi" value="&lt;b&gt;/www/cgi-bin/firetv-api  (firetv-api.uc)&lt;/b&gt;&lt;br&gt;ADB transport + app launcher for the Fire TV Stick.&lt;br&gt;Same escSQ() double-escaping and package-name whitelist&lt;br&gt;(^[A-Za-z0-9_.]+$) as mitv-api.&lt;br&gt;&lt;br&gt;⚠ The repo also contains a plain `firetv-api` (bash). It is a&lt;br&gt;  stale pre-ucode leftover, NOT deployed. Always edit .uc." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="680" width="640" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="state3" value="&lt;b&gt;/tmp/entertainment-status.json  (every 3 s)&lt;/b&gt;&lt;br&gt;tv{} ftv{} now_playing{title,show,season,episode,poster_url,position,duration}&lt;br&gt;sound_profile · audio_output_type · arc_active · sony_hometheater{}&lt;br&gt;⚠ sony_hometheater.arc_handshake / sound_mode were hardcoded strings&lt;br&gt;  for months — they now read tv.arc_active / tv.sound_profile." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#9e9e9e;dashed=1;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="890" width="640" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ui3" value="&lt;b&gt;/www/mesh.html  —  Mi TV / Fire TV / HT tabs&lt;/b&gt;&lt;br&gt;Now Playing card (poster, series, S/E, guarded scrubber)&lt;br&gt;Display &amp;amp; Sound panel — sliders bound to display_state&lt;br&gt;  #mitv-active-mode shows WHICH mode the sliders edit, amber&lt;br&gt;  with a warning on a Dolby Vision mode&lt;br&gt;Best Audio Profile card — live badge + format line&lt;br&gt;  (12 s client-side throttle; audio_format runs dumpsys)&lt;br&gt;  🔍 Show on TV → 2 s on-screen HUD via the companion agent&lt;br&gt;Scene Console · Mi TV Remote · YouTube app lock&lt;br&gt;⚠ applyMasterPreset() must route through mitv-api, never&lt;br&gt;  call the TV’s Rust agent :9988 directly (bypasses the guard)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="1030" width="640" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="mitv" value="&lt;b&gt;Xiaomi Mi QLED 75  ·  192.168.0.10  ·  MT9611 / Android 11 (8835)&lt;/b&gt;&lt;br&gt;Control surfaces exposed to the router:&lt;br&gt;  adb :5555            Settings.Global / dumpsys / am / pm&lt;br&gt;  :8080  tv-telemetry-agent (com.home.tvagent)&lt;br&gt;         accessibility scraper + MediaSession + enrichment&lt;br&gt;  :9988  mitv-rust-agent  (fast preset path, shell domain)&lt;br&gt;&lt;br&gt;What is REAL on this firmware:&lt;br&gt;  sound_dts_virtual_x · dts_virtual_surround · dts_dialog_clarity&lt;br&gt;  dts_bass_enhancement · sound_dts_drc  → MediaTek config IDs&lt;br&gt;  all sound_dbx_* · sonic_emotion · sound_dts_studio_* : INERT&lt;br&gt;&lt;br&gt;Enum traps:&lt;br&gt;  sound_output_switch  5=HDMI-ARC  6=SPDIF  7=SPEAKER  0/1=BT&lt;br&gt;  sound_digital_output_arc  7=Auto (correct)  4=Passthrough&lt;br&gt;  encoded_surround_output  3 (MANUAL) is CLAMPED to ALWAYS&lt;br&gt;&lt;br&gt;⚠ settings put + settings get round-tripping is NOT proof.&lt;br&gt;  Verify against dumpsys media.audio_policy / hdmi_control." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="100" width="580" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="firetv" value="&lt;b&gt;Fire TV Stick 4K  ·  192.168.0.7  ·  AFTMM / Fire OS 6&lt;/b&gt;&lt;br&gt;HDMI 1 into the Mi TV · CEC logical address 1.0.0.0&lt;br&gt;hdmi_audio_out_format=1 → E-AC3 bitstream passthrough&lt;br&gt;hdmi_resolution=3      → 4K60 locked&lt;br&gt;Animation scales 0.5 · av_sync_offset 30 · Alexa mic off&lt;br&gt;No companion agent — browser-side enrichment tiers still apply." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="560" width="580" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="sony" value="&lt;b&gt;Sony HT-S40R 5.1  ·  CEC 0x05  ·  vendor 0x080046&lt;/b&gt;&lt;br&gt;HDMI 2, PLAIN ARC (mEarcConnected: false) — compressed 5.1&lt;br&gt;bitstream OR 2.0 LPCM, never multichannel PCM.&lt;br&gt;Dolby Digital / Digital Plus only: no TrueHD, no Atmos, NO DTS.&lt;br&gt;The TV has decoders but NO encoder — anything the TV decodes&lt;br&gt;reaches the Sony as stereo. TV-side DSP and discrete 5.1 are&lt;br&gt;therefore mutually exclusive on this link." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="760" width="580" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="blocked" value='&lt;b&gt;Routes that are CLOSED (verified, do not re-attempt)&lt;/b&gt;&lt;br&gt;Sony vendor CEC frames (0xA0 sound-field / theater modes):&lt;br&gt;  cec-client / libCEC      not present, no /dev/cec*&lt;br&gt;  cmd hdmi_control ...     "No shell command implementation"&lt;br&gt;  /dev/mik!cec             SELinux denies the shell domain&lt;br&gt;  binder sendVendorCommand HDMI_CEC perm is signature|priv&lt;br&gt;  app-domain middleware    loads, returns rc=0, TRANSMITS NOTHING&lt;br&gt;  Shizuku would not help — it grants shell, the denied domain.&lt;br&gt;IR (DRC, subwoofer, surround trims): the TV has no emitter&lt;br&gt;  (no consumerir feature/HAL); the binder stub is AOSP noise.&lt;br&gt;&lt;br&gt;What DOES work over CEC, through the TV’s System Audio path:&lt;br&gt;  volume / mute   input keyevent → &amp;lt;User Control Pressed&amp;gt;&lt;br&gt;  power           KEYCODE_SLEEP → &amp;lt;Standby&amp;gt; 0F:36 broadcast&lt;br&gt;  system audio    hdmi_system_audio_control_enabled 0/1&lt;br&gt;  power status    Sony answers &amp;lt;Report Power Status&amp;gt; 50:90:00&lt;br&gt;&lt;br&gt;→ Only a USB-CEC adapter (Pulse-Eight) or an IR blaster would&lt;br&gt;  extend this. ⚠ Heavy live CEC toggling once degraded the TV’s&lt;br&gt;  CEC state badly enough to need a full reboot — and produced a&lt;br&gt;  confident but WRONG "Sony firmware bug" conclusion.' style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Courier New;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="970" width="580" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="adb + :8080 agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="entpoll" target="mitv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="adb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="entpoll" target="firetv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="adb writes (guarded)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="mitvapi" target="mitv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="adb writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="firetvapi" target="firetv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="HDMI 2 ARC + CEC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="mitv" target="sony">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="HDMI 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="firetv" target="mitv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entpoll" target="state3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="polled by the dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="state3" target="ui3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="user actions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui3" target="mitvapi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="edge trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="entpoll" target="dsp">
